{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Failure Lab incident report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "scenario", "title", "target", "runbook", "timeline", "diagnosis", "verification"],
  "properties": {
    "format": {"const": "failure-lab/incident-report-v1"},
    "scenario": {"$ref": "#/$defs/key"},
    "title": {"$ref": "#/$defs/text"},
    "target": {"$ref": "#/$defs/text"},
    "runbook": {"type": "string", "pattern": "^knowledge/[a-z0-9-]+\\.md$"},
    "timeline": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "evidence_stages"],
      "properties": {
        "summary": {"$ref": "#/$defs/text"},
        "evidence_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/key"}
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_ids", "ledger", "result"],
      "properties": {
        "accepted_ids": {"$ref": "#/$defs/ids"},
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reservations", "tickets"],
          "properties": {
            "reservations": {"type": "array", "items": {"$ref": "#/$defs/reservation"}},
            "tickets": {"type": "array", "items": {"$ref": "#/$defs/ticket"}}
          }
        },
        "result": {"$ref": "#/$defs/result"}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "count": {"type": "integer", "minimum": 0},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "observed_at", "summary", "sources", "facts"],
      "properties": {
        "stage": {"$ref": "#/$defs/key"},
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "summary": {"$ref": "#/$defs/text"},
        "sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "facts": {"type": "object", "description": "Small, scenario-specific normalized observations."}
      }
    },
    "reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "event_id"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "status": {"enum": ["PENDING", "ISSUED"]},
        "event_id": {"anyOf": [{"$ref": "#/$defs/text"}, {"type": "null"}]}
      }
    },
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reservation_id", "source_event_id"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "reservation_id": {"$ref": "#/$defs/text"},
        "source_event_id": {"$ref": "#/$defs/text"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed", "accepted", "reservations", "tickets", "duplicate_accepted_ids",
        "missing_reservations", "unexpected_reservations", "duplicate_reservations", "not_issued",
        "missing_tickets", "duplicate_tickets", "duplicate_ticket_ids", "unexpected_tickets",
        "unmatched_source_events"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "accepted": {"$ref": "#/$defs/count"},
        "reservations": {"$ref": "#/$defs/count"},
        "tickets": {"$ref": "#/$defs/count"},
        "duplicate_accepted_ids": {"$ref": "#/$defs/ids"},
        "missing_reservations": {"$ref": "#/$defs/ids"},
        "unexpected_reservations": {"$ref": "#/$defs/ids"},
        "duplicate_reservations": {"$ref": "#/$defs/ids"},
        "not_issued": {"$ref": "#/$defs/ids"},
        "missing_tickets": {"$ref": "#/$defs/ids"},
        "duplicate_tickets": {"$ref": "#/$defs/ids"},
        "duplicate_ticket_ids": {"$ref": "#/$defs/ids"},
        "unexpected_tickets": {"$ref": "#/$defs/ids"},
        "unmatched_source_events": {"$ref": "#/$defs/ids"}
      }
    }
  }
}
